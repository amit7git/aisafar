# YouTube Data API v3 key (server-side-style key, browser-safe enough for a client project).
# Required to lift the 200-video playlist cap (the IFrame player API only loads ~200 videos).
# When omitted, playlists load via the built-in player path (existing behavior).
# Create one at https://console.cloud.google.com/apis/credentials, then enable:
#   YouTube Data API v3  (for the current project)
VITE_YOUTUBE_API_KEY=

# Server-only Gemini API key for the POST /api/ai-safar endpoint.
# PRIVATE / SERVER-SIDE ONLY. NEVER prefix with VITE_ — it must never reach
# the browser and is read only from process.env by the endpoint.
# Set this in the Vercel project dashboard as an Encrypted variable
# (or in .env.local while developing; never commit .env.local).
GEMINI_API_KEY=

# Optional override of the Gemini model (default: gemini-3.6-flash).
# Private / server-side only. Server-only, like GEMINI_API_KEY.
GEMINI_MODEL=gemini-3.6-flash